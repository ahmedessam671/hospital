@model IEnumerable<Patient>

<div class="container mt-4">
    <h2 class="mb-3">All Items</h2>

    <a asp-action="Create" class="btn btn-primary mb-3">Add New</a>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                @foreach (var prop in typeof(Patient).GetProperties())
                {
                    <th>@prop.Name</th>
                }
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @{
                int i = 1;
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@i</td>
                    @foreach (var prop in item.GetType().GetProperties())
                    {
                        <td>@prop.GetValue(item)</td>
                    }
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
                i++;
            }
        </tbody>
    </table>
</div>
